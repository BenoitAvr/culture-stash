generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String?    @unique
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  // Set to true for ad-hoc users created server-side when a guest saves a
  // tier list without being logged in. Lets analytics filter real users
  // from anonymous contributors, and the login-time "claim" flow transfer
  // their lists onto a real account.
  anonymous    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  notes        Note[]
  likes        Like[]
  resources    Resource[]
  userLists    UserList[]
  entries         Entry[]
  userEntries     UserEntry[]
  userEntryLists  UserEntryList[]
  userTopicNotes  UserTopicNote[]
  ownedGroups     Group[]         @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupMessages   GroupMessage[]
}

model Topic {
  id        String     @id @default(cuid())
  slug      String     @unique
  emoji     String
  badge     String
  title     String
  desc      String
  prose     String
  diffLevel Int        @default(3)
  diffNote  String
  rankable  Boolean    @default(false)
  createdAt DateTime   @default(now())
  parentId  String?
  parent    Topic?     @relation("SubTopics", fields: [parentId], references: [id])
  children  Topic[]    @relation("SubTopics")
  concepts      Concept[]
  related       Related[]
  resources     Resource[]
  notes         Note[]
  userLists       UserList[]
  translations    TopicTranslation[]
  entries         Entry[]
  userEntryLists  UserEntryList[]
  userTopicNotes  UserTopicNote[]
  groups          Group[]
}

model Concept {
  id      String @id @default(cuid())
  topicId String
  name    String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Related {
  id      String @id @default(cuid())
  topicId String
  name    String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Resource {
  id        String   @id @default(cuid())
  topicId   String
  addedById String?
  title     String
  sub       String
  type      String
  emoji     String
  url       String?
  createdAt DateTime @default(now())
  topic         Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  addedBy       User?                @relation(fields: [addedById], references: [id])
  userListItems UserListItem[]
  translations  ResourceTranslation[]
}

model Note {
  id        String    @id @default(cuid())
  topicId   String
  authorId  String
  title     String
  excerpt   String
  content   String
  createdAt DateTime  @default(now())
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      NoteTag[]
  likes     Like[]
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  name   String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
}

model TopicTranslation {
  id       String @id @default(cuid())
  topicId  String
  lang     String
  badge    String
  title    String
  desc     String
  prose    String
  diffNote String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, lang])
}

model ResourceTranslation {
  id         String   @id @default(cuid())
  resourceId String
  lang       String
  title      String
  sub        String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, lang])
}

model Entry {
  id          String      @id @default(cuid())
  topicId     String
  addedById   String?
  title       String
  titleEn     String?
  tmdbId      String?
  year        Int?
  cover       String?
  // 'FILM' (default) or 'SAGA' — SAGA entries represent a whole franchise
  // (e.g. Harry Potter en entier) so users can vote on the saga as a unit
  // instead of (or in addition to) individual films. Year is optional for
  // sagas since there isn't a single release date.
  kind        String      @default("FILM")
  // Comma-separated TMDB genre IDs ("35,18"), stable across locales. Null
  // for entries whose source API doesn't carry genres yet (e.g. older
  // backfills) or for SAGA entries where no single TMDB record applies.
  genres      String?
  createdAt   DateTime    @default(now())
  topic              Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  addedBy            User?           @relation(fields: [addedById], references: [id])
  userEntries        UserEntry[]
  userEntryListItems UserEntryItem[]

  @@index([topicId, tmdbId])
}

model UserEntry {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  stars     Int?
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model UserEntryList {
  id          String          @id @default(cuid())
  userId      String
  topicId     String
  type        String          // 'RANKED' | 'TIER' | 'BOTH'
  rankedTiers String?         // comma-separated tiers with per-tier ranking, e.g. "S,A"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  items       UserEntryItem[]

  @@unique([userId, topicId, type])
}

model UserEntryItem {
  id        String        @id @default(cuid())
  listId    String
  entryId   String
  position  Int?
  tier      String?
  note      String?
  list      UserEntryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  entry     Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model UserList {
  id          String         @id @default(cuid())
  userId      String
  topicId     String
  type        String
  rankedTiers String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  items     UserListItem[]

  @@unique([userId, topicId])
}

model UserListItem {
  id         String   @id @default(cuid())
  listId     String
  resourceId String
  position   Int?
  tier       String?
  note       String?
  list       UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model UserTopicNote {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  content   String
  public    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

// Private tier-list groups. A group is scoped to a single topic (films, series,
// etc.) so members compare their tier lists for that topic. People who want to
// rank several topics with the same friends create one group per topic. The
// inviteSlug is the share token that lands people on /g/<slug> and auto-joins
// them if they're signed in.
model Group {
  id         String         @id @default(cuid())
  name       String
  inviteSlug String         @unique
  topicId    String
  ownerId    String
  createdAt  DateTime       @default(now())
  topic      Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  owner      User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  messages   GroupMessage[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER") // 'OWNER' | 'MEMBER'
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// Lightweight chat inside a group. When `entryId` is set, the message is a
// per-film reaction (anchored to the ranking row); when null, it's a message
// in the group's general chat.
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  entryId   String?
  body      String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([groupId, entryId, createdAt])
}
